<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Caixa_eletrônico</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <main class="atm">

        <header class="cabelcalho">
            <h1>Banco Bradesco </h1>
        </header>

        <section class="ciaxa">

            <h2>Caixa eletrônico</h2>

            <div class="saldo"> 

                <p>Saldo Disponível</p>
                <strong>R$ 1.000,00</strong>
            </div>

            <div class="saque">

                <label for="valor">Digite o valor desejado</label>

                <input type="number" id="valor" placeholder="R$ 0,00">

                <button id="btnsacar">Sacar</button>
            </div>

            <div id="resultado" class="resultado"></div>
            
        </section>
        

    </main>
    <script src="script.js"></script>
</body>
</html>
